# Banco de dados (Postgres 16). Local: docker compose up -d
DATABASE_URL=postgres://urutau:urutau@localhost:5432/urutau
# Usado pelos testes automatizados (o schema é recriado a cada execução)
TEST_DATABASE_URL=postgres://urutau:urutau@localhost:5432/urutau_test

# Publicação (ex.: Vercel + Neon):
# DATABASE_URL=<connection string do Neon, pode ser a "pooled">
# DATABASE_URL_UNPOOLED=<connection string direta, usada nas migrações; a integração Neon cria sozinha>
# SEED_SENHA=<senha das contas de exemplo, se rodar o seed no banco publicado>

# Rotina diária (vercel.json → /api/cron). A Vercel envia "Authorization: Bearer <CRON_SECRET>".
# Gere um valor longo e aleatório e cadastre em Settings → Environment Variables.
# CRON_SECRET=
